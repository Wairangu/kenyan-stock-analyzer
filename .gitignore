# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project data (generated daily)
reports/
data/
logs/

# Claude Code settings (may contain local paths/secrets)
.claude/

# Environment variables (contains secrets)
.env
.env.local
*.env

# Keep example files
!.env.example

# Jupyter notebooks
.ipynb_checkpoints/

# PDF/Excel output
*.pdf
*.xlsx

# Terraform (state may contain resource details; never commit it).
# Note: .terraform.lock.hcl is intentionally NOT ignored -- it pins
# provider versions and should be committed for reproducible applies.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/terraform.tfvars
terraform/crash.log
terraform/.build/